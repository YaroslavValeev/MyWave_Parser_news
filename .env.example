# Скопируйте в .env и заполните. Файл .env в git не коммитится.
#
# Важно (регионы с ограничениями): Bot API (long poll) и Telethon требуют
# исходящего доступа к Telegram. Без VPN на хосте или без рабочего SOCKS к
# api.telegram.org бот и сбор по Telegram-каналам будут нестабильны. На VPS
# обычно поднимают постоянный VPN/прокси, а не клиент «на ноутбуке».

TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID_USER=
TELEGRAM_API_HASH_USER=

# --- competitions_ticker (бегущая строка на mywavewake.ru) ---
# Тот же GOOGLE_SHEET_ID, отдельный лист competitions_ticker
# COMPETITIONS_SHEET_NAME=competitions_ticker
# COMPETITIONS_SYNC_ENABLED=true
# COMPETITIONS_ARCHIVE_HOUR=3
# COMPETITIONS_ARCHIVE_MINUTE=15
# После bulk-import на сайте: POST {SITE_BASE_URL}/api/competitions/cache/invalidate
# COMPETITIONS_CACHE_INVALIDATE_ENDPOINT=/api/competitions/cache/invalidate
# COMPETITIONS_CACHE_INVALIDATE_TOKEN=  # пусто = MEDIA_UPLOAD_TOKEN или SITE_CACHE_INVALIDATE_TOKEN
# COMPETITIONS_IWWF_CALENDAR_URL=https://www.iwwf.sport/past-and-upcoming-events/
# COMPETITIONS_WWA_ICAL_URL=webcal://www.thewwa.com/?post_type=tribe_events&ical=1&eventDisplay=list
# COMPETITIONS_CWSA_CALENDAR_URL=https://thecwsa.org/events/2026
# COMPETITIONS_COLLECT_ENABLED=false

FSM_STORAGE_BACKEND=sqlite
FSM_SQLITE_PATH=data/fsm_state.db
FSM_STATE_TTL_SECONDS=86400

# Docker Compose: host path to Google service-account JSON.
# The container sees it as /run/secrets/google-credentials.json.
GOOGLE_CREDENTIALS_HOST_FILE=./credentials.json

# Канал для постов (супергруппа/канал: -100...)
CHANNEL_ID=
# Допустимо то же под другим именем:
# TELEGRAM_CHANNEL_ID=

# Чат редакторов для карточек ревью (числовой id или @username)
EDITORS_CHAT_ID=

# OpenAI (NLP): при пустой очереди new и сотнях error в БД сначала:
#   python scripts/analyze_error_status.py
# Типично: неверный ключ (401), регион (unsupported_country), нет доступа к TEXT_MODEL.
# OPENAI_API_KEY=
# OPENAI_HTTP_PROXY=socks5://user:pass@host:port  # для VPS в РФ (403 unsupported_country)
# TEXT_MODEL=gpt-4o-mini
# WHISPER_MODEL=whisper-1
# (gpt-4o-transcribe требует отдельного доступа в OpenAI-проекте; на prod — whisper-1)
# OpenAI: при 403 на /v1/moderations можно явно отключить вызов модерации
# OPENAI_SKIP_MODERATION=false

# --- Медиа для сайта / Google Sheets raw_feed ---
# Если Parser сохраняет файл локально (downloads/review_media/... или media/...),
# сайт сможет показать его только через публичный URL.
# Пример: PUBLIC_MEDIA_BASE_URL=https://mywave.example
# Тогда downloads/review_media/a.jpg уйдёт в raw_feed как:
# https://mywave.example/static/downloads/review_media/a.jpg
PUBLIC_MEDIA_BASE_URL=
# Разрешать писать относительные /static/... в raw_feed только если сайт читает тот же домен
# и реально отдаёт эти файлы. По умолчанию безопаснее false.
ALLOW_RELATIVE_STATIC_MEDIA_IN_RAW_FEED=false

# --- Upload обложек на сайт ---
# Production-контур: Parser -> сайт /api/blog/media/upload -> публичный URL -> raw_feed.cover_image_url
# SITE_BASE_URL нужен, если MEDIA_UPLOAD_ENDPOINT задан относительным путём.
# Production: https://mywavewake.ru (не http://127.0.0.1:5000 на VPS!)
SITE_BASE_URL=https://mywavewake.ru
MEDIA_UPLOAD_ENDPOINT=/api/blog/media/upload
MEDIA_UPLOAD_TOKEN=
MEDIA_UPLOAD_TIMEOUT_SECONDS=60
MEDIA_UPLOAD_MAX_BYTES=10485760

# --- Сброс кэша витрины сайта после обновления raw_feed ---
# По умолчанию можно использовать тот же токен, что и для upload,
# но для production лучше отдельный secret.
SITE_CACHE_INVALIDATE_ENDPOINT=/api/blog/cache/invalidate
# Если пусто, код возьмёт MEDIA_UPLOAD_TOKEN.
SITE_CACHE_INVALIDATE_TOKEN=
SITE_CACHE_INVALIDATE_TIMEOUT_SECONDS=15

# --- Планировщик ---
# Интервал полного сбора (мин). По умолчанию в коде 30 — меньше пересечений с длинным обходом источников.
# COLLECT_INTERVAL_MINUTES=30
# За один тик обрабатывать только N источников (round-robin), 0 = все за тик.
# COLLECT_SOURCES_CHUNK_SIZE=0

# --- RSS / YouTube Atom (отдельно от Bot API): таймаут и опциональный HTTP(S) прокси ---
# HTTP_FEED_TIMEOUT_SECONDS=30
# HTTP_FEED_PROXY=http://127.0.0.1:7890
# Только ленты youtube.com/feeds (если общий прокси даёт 404, а прямой — нет, или наоборот):
# HTTP_YOUTUBE_FEED_PROXY=http://127.0.0.1:7890
# Допустимо псевдоним: HTTP_RSS_PROXY=

# --- Команда /requeue_nlp (владелец) ---
# REQUEUE_NLP_COOLDOWN_SECONDS=60
# REQUEUE_NLP_MAX_PER_HOUR=20

# --- Прокси (если api.telegram.org или сбор недоступны без VPN) ---
# Общий прокси для Telethon и др. (SOCKS5 по умолчанию)
PROXY_ENABLED=false
PROXY_TYPE=socks5
PROXY_HOST=
PROXY_PORT=1080
PROXY_USER=
PROXY_PASS=

# Bot API (aiogram / bot_aiogram.py): использовать тот же PROXY_* при PROXY_ENABLED=true
BOT_API_USE_PROXY=true

# Отдельный прокси только для бота (если Telethon идёт на удалённый SOCKS, а боту нужен локальный)
# Пример: Clash / v2rayN — порт SOCKS из настроек клиента
# BOT_API_PROXY_URL=socks5://127.0.0.1:7891

# Если PROXY_HOST удалённый и недоступен, а на этом ПК поднят Clash — перебор после основного варианта:
# BOT_API_PROXY_FALLBACK_URLS=socks5://127.0.0.1:7890,socks5://127.0.0.1:7891,socks5://127.0.0.1:10808

# Таймаут HTTP к api.telegram.org (сек), по умолчанию 120 (нестабильная сеть / Windows)
# BOT_API_REQUEST_TIMEOUT=120
# TTL DNS для прямого TCP (без SOCKS для Bot API), по умолчанию 300
# BOT_API_CONNECTOR_DNS_TTL=300

# При удалённом PROXY_HOST автоматически пробовать 127.0.0.1:7890, 7891, 10808, 1080 (Clash/v2rayN)
# BOT_API_TRY_LOCAL_SOCKS=true
