+            ),
+            client=sdk,
+        )
+        ai.generate_cover = AsyncMock(return_value={})
+        ai.moderate = AsyncMock(return_value={"flagged": False})
+        with (
+            patch.object(config, "SOURCE_ARTICLE_FETCH_ENABLED", True),
+            patch.object(
+                config, "SOURCE_ARTICLE_ALLOWED_HOSTS", ("article.example.test",)
